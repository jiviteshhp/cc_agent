# Copy this file to .env for local development. Never commit .env.
SARVAM_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Host only, without https:// or a path. Example: voice.example.in
SERVER_HOST=localhost:8001
CLINIC_NAME=Development Clinic

# Voice tuning defaults
NOISE_CANCELLATION=true
NOISE_CANCELLATION_LEVEL=40
SARVAM_VAD_HIGH=false
SARVAM_STT_MODE=codemix
