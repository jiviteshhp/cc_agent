# Copy this file to .env for local development. Never commit .env.
SARVAM_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# 3.6 supports minimal thinking for spoken turns. Use low for 3.7/3.8 overrides.
GEMINI_THINKING_LEVEL=minimal
# Optional browser/phone speech-to-speech engine, using GEMINI_API_KEY (AI Studio).
# Independent of the cascaded text model; no automatic provider/model fallback.
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Kore
# Incoming phone calls: cascaded (existing Sarvam pipeline) or s2s (Gemini Live).
# Independent of the website's per-browser selector. Restart phone between calls.
PHONE_VOICE_ENGINE=cascaded
LLM_FIRST_TEXT_TIMEOUT=5
LLM_CHUNK_TIMEOUT=5
LLM_REQUEST_TIMEOUT=30

# Vertex AI uses application default credentials. Confirm credit/model access.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Local phone: ngrok hostname (8002), without https:// or a path.
# AWS production Compose uses WEB_HOST for the phone endpoint automatically.
# Not needed for the local browser playground.
SERVER_HOST=
# Random callback secret, at least 32 characters; this is NOT a founder password.
VOBIZ_WEBHOOK_SECRET=
CLINIC_NAME=Development Clinic
# Optional single private laptop IPv4; scripts/phone_demo.py sets it automatically.
# Leave empty for localhost-only use. Never use a wildcard or public tunnel host.
LOCAL_DEMO_HOST=
# Hosted browser only; see docs/AWS_SETUP.md. Separate from phone SERVER_HOST.
WEB_HOST=
# Generate with caddy hash-password; single-quote the hash to preserve its $ signs.
# Username is demo. Never put the plaintext demo password here.
DEMO_PASSWORD_HASH=

# Realtime STT (new endpoint/protocol; no automatic model fallback).
SARVAM_STT_MODEL=saaras:v4
# Bounded startup/reconnect tolerance; does not change speech turn latency.
SARVAM_STT_START_TIMEOUT=30
SARVAM_STT_OPEN_TIMEOUT=8
SARVAM_STT_ACK_TIMEOUT=8
SARVAM_STT_SEND_TIMEOUT=2
SARVAM_STT_LANGUAGE=hi-IN
SARVAM_STT_MODE=codemix
SARVAM_STT_STREAM_TYPE=fast
SARVAM_VAD_THRESHOLD=0.3
SARVAM_VAD_PREFIX_MS=300
SARVAM_VAD_SILENCE_MS=500
SARVAM_VAD_MIN_SPEECH_MS=250
# Extra quiet time after final transcripts, with a speech-active turn gate.
STT_TURN_DEBOUNCE_MS=400
# Telephone interruptions need recognized speech, not VAD alone (2–8 words).
PHONE_BARGE_IN_MIN_WORDS=3
# Browser already receives endpointed finals; shorter extra quiet period.
BROWSER_TURN_DEBOUNCE_MS=120
# Browser noise resistance, independent of the phone SARVAM_* defaults above.
# More conservative recognition; raising these further can miss soft/short speech.
BROWSER_STT_STREAM_TYPE=balanced
BROWSER_VAD_THRESHOLD=0.6
BROWSER_VAD_MIN_SPEECH_MS=150
# Optional terminology only; do not put patient details/expected answers here.
# The browser uses its editable ASR context instead; clearing it disables the hint.
SARVAM_STT_PROMPT=
# Browser: bulbul:v4-flash Ritu PCM at 24 kHz.
# Phone: direct bulbul:v4-flash/Ritu PCM at 8 kHz, one stream per reply, no TTS fallback.
# Set SARVAM_VAD_MIN_SPEECH_MS=150 to admit very short telephone yes/no answers;
# an explicit 250 ms override still takes precedence over the phone default.
# Removed: SARVAM_VAD_HIGH, NOISE_CANCELLATION, NOISE_CANCELLATION_LEVEL.
# Vobiz Stream has no documented noise/isolation switch; see docs/VOICE_QUALITY.md.
