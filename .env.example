# Copy this file to .env for local development. Never commit .env.
SARVAM_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# 3.6 supports minimal thinking for spoken turns. Use low for 3.7/3.8 overrides.
GEMINI_THINKING_LEVEL=minimal
LLM_FIRST_TEXT_TIMEOUT=5
LLM_CHUNK_TIMEOUT=5
LLM_REQUEST_TIMEOUT=30

# Vertex AI uses application default credentials. Confirm credit/model access.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# ngrok hostname for the phone-only port (8002), without https:// or a path.
# Not needed for the local browser playground.
SERVER_HOST=
# Random callback secret, at least 32 characters; this is NOT a founder password.
VOBIZ_WEBHOOK_SECRET=
CLINIC_NAME=Development Clinic
# Optional single private laptop IPv4; scripts/phone_demo.py sets it automatically.
# Leave empty for localhost-only use. Never use a wildcard or public tunnel host.
LOCAL_DEMO_HOST=

# Realtime STT (new endpoint/protocol; no automatic model fallback).
SARVAM_STT_MODEL=saaras:v4
SARVAM_STT_LANGUAGE=hi-IN
SARVAM_STT_MODE=codemix
SARVAM_STT_STREAM_TYPE=fast
SARVAM_VAD_THRESHOLD=0.3
SARVAM_VAD_PREFIX_MS=300
SARVAM_VAD_SILENCE_MS=500
SARVAM_VAD_MIN_SPEECH_MS=250
# Extra quiet time after final transcripts, with a speech-active turn gate.
STT_TURN_DEBOUNCE_MS=400
# Browser already receives endpointed finals; shorter extra quiet period.
BROWSER_TURN_DEBOUNCE_MS=120
# Optional terminology only; do not put patient details/expected answers here.
SARVAM_STT_PROMPT=
# Browser: bulbul:v3 raw PCM at 24 kHz; Priya/Ishita/Ritu selected in the UI.
# Phone: existing bulbul:v3/Ritu at 8 kHz.
# Removed: SARVAM_VAD_HIGH, NOISE_CANCELLATION, NOISE_CANCELLATION_LEVEL.
# Vobiz Stream has no documented noise/isolation switch; see docs/VOICE_QUALITY.md.
